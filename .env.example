# Conexión a PostgreSQL
DATABASE_URL=postgresql://darocutz:CAMBIA_ESTO@localhost:5432/darocutz_db

# Contraseña de PostgreSQL que usa docker-compose.yml
DB_PASSWORD=CAMBIA_ESTO

# Clave de firma de sesión. Genérala con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_POR_AL_MENOS_32_CARACTERES_ALEATORIOS

# true | false | auto  (por defecto "auto": Secure solo cuando la peticion llega por https)
COOKIE_SECURE=auto
