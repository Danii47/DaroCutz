---
import "@/styles/global.css";
import "@/styles/toast.css";

interface Props {
  title: string;
  description: string;
  /** Oculta la barra superior (páginas de login y registro). */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const user = Astro.locals.user;
const homeHref = user ? (user.isAdmin ? "/admin" : "/request-appointment") : "/login";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#121212" />
    <title>{title} · DaroCutz</title>
    <meta name="description" content={description} />
  </head>
  <body>
    {
      !bare && (
        <header class="site-header">
          <div class="site-header__inner">
            <a class="brand" href={homeHref}>
              <span class="brand__mark" aria-hidden="true">
                ✂
              </span>
              DaroCutz
            </a>

            {user && (
              <div class="site-header__meta">
                <span class="site-header__user" title={user.email}>
                  {user.email}
                </span>
                {user.isAdmin && <span class="badge badge--warning">Admin</span>}
                <button id="logout-button" class="btn btn--ghost btn--sm" type="button">
                  Salir
                </button>
              </div>
            )}
          </div>
        </header>
      )
    }

    <slot />

    <script>
      import { initToastContainer, toast } from "@/lib/toast";

      initToastContainer();

      document.getElementById("logout-button")?.addEventListener("click", async () => {
        try {
          const response = await fetch("/api/auth/logout", { method: "POST" });
          const result = await response.json();
          window.location.href = result.redirectTo || "/login";
        } catch {
          toast.error("No se ha podido cerrar la sesión. Inténtalo de nuevo.");
        }
      });
    </script>
  </body>
</html>
