---
import Layout from "@/layouts/Layout.astro";
import { MIN_PASSWORD_LENGTH } from "@/lib/password";
---

<Layout title="Crear cuenta" description="Regístrate para poder reservar tus citas" bare>
  <main class="page page--narrow">
    <div class="card auth">
      <div class="auth__head">
        <span class="brand__mark auth__mark" aria-hidden="true">✂</span>
        <h1 class="auth__title">Crear cuenta</h1>
        <p class="page-subtitle">El barbero validará tu alta antes de que puedas reservar</p>
      </div>

      <form id="register-form" novalidate>
        <div class="field">
          <label class="field__label" for="full-name">Nombre completo</label>
          <input
            class="input"
            type="text"
            id="full-name"
            name="fullName"
            autocomplete="name"
            placeholder="Daniel del Pozo"
            minlength="3"
            maxlength="120"
            required
          />
        </div>

        <div class="field">
          <label class="field__label" for="email">Correo electrónico</label>
          <input
            class="input"
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            placeholder="email@gmail.com"
            required
          />
        </div>

        <div class="field">
          <label class="field__label" for="phone">Teléfono</label>
          <input
            class="input"
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            inputmode="numeric"
            placeholder="678123654"
            pattern="[0-9]{9}"
            maxlength="9"
            required
          />
          <span class="field__hint">9 dígitos, sin prefijo</span>
        </div>

        <div class="field">
          <label class="field__label" for="password">Contraseña</label>
          <input
            class="input"
            type="password"
            id="password"
            name="password"
            autocomplete="new-password"
            placeholder="••••••••"
            minlength={MIN_PASSWORD_LENGTH}
            required
          />
          <span class="field__hint">Mínimo {MIN_PASSWORD_LENGTH} caracteres</span>
        </div>

        <div class="field">
          <label class="field__label" for="confirm-password">Repite la contraseña</label>
          <input
            class="input"
            type="password"
            id="confirm-password"
            name="confirmPassword"
            autocomplete="new-password"
            placeholder="••••••••"
            minlength={MIN_PASSWORD_LENGTH}
            required
          />
        </div>

        <button class="btn btn--primary btn--block" type="submit" style="margin-top: 22px;">
          Crear cuenta
        </button>
      </form>

      <div class="divider"><span>o</span></div>

      <p class="auth__foot">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </div>
  </main>
</Layout>

<script>
  import { toast } from "@/lib/toast";

  const form = document.getElementById("register-form") as HTMLFormElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const password = String(data.get("password") || "");
    const confirmPassword = String(data.get("confirmPassword") || "");

    if (password !== confirmPassword) {
      toast.error("Las contraseñas no coinciden.");
      return;
    }

    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    button.disabled = true;

    try {
      const response = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          fullName: String(data.get("fullName") || ""),
          email: String(data.get("email") || ""),
          phone: String(data.get("phone") || ""),
          password,
          confirmPassword,
        }),
      });

      const result = await response.json();

      if (result.success) {
        toast.success(result.message);
        setTimeout(() => (window.location.href = "/login"), 1400);
        return;
      }

      toast.error(result.error);
      button.disabled = false;
    } catch {
      toast.error("No hay conexión con el servidor. Inténtalo de nuevo.");
      button.disabled = false;
    }
  });
</script>

<style>
  .auth {
    padding: 34px 30px;
  }

  .auth__head {
    text-align: center;
    margin-bottom: 26px;
  }

  .auth__mark {
    width: 44px;
    height: 44px;
    margin: 0 auto 14px;
    font-size: 21px;
    border-radius: 13px;
  }

  .auth__title {
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .auth__foot {
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .auth {
      padding: 28px 22px;
    }
  }
</style>
