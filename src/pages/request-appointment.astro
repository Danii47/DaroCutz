---
import Layout from "@/layouts/Layout.astro";
import { capitalize, formatMadrid, madridDayKey } from "@/lib/datetime";
import { getClientSlots } from "@/lib/queries";

const user = Astro.locals.user!;

// Consulta directa: la página ya no se hace un fetch a sí misma, así que no
// puede quedarse vacía porque falle una llamada interna.
const slots = await getClientSlots(user.id);

const myBooking = slots.find((slot) => slot.isMine) ?? null;

const slotsByDay = new Map<string, typeof slots>();
for (const slot of slots) {
  const key = madridDayKey(slot.appointmentDate);
  const group = slotsByDay.get(key);
  if (group) group.push(slot);
  else slotsByDay.set(key, [slot]);
}

const days = [...slotsByDay.entries()].map(([key, daySlots]) => ({
  key,
  slots: daySlots,
  weekday: formatMadrid(daySlots[0].appointmentDate, { weekday: "short" }),
  dayNumber: formatMadrid(daySlots[0].appointmentDate, { day: "numeric" }),
  month: formatMadrid(daySlots[0].appointmentDate, { month: "short" }),
  freeCount: daySlots.filter((slot) => !slot.isBooked).length,
}));

const initialDay = days.find((day) => day.freeCount > 0)?.key ?? days[0]?.key ?? "";
const todayKey = madridDayKey(new Date());
---

<Layout title="Reservar cita" description="Elige el día y la hora de tu próximo corte">
  <main class="page page--booking">
    <header class="booking-head">
      <h1 class="page-title">Reservar cita</h1>
      <p class="page-subtitle">Elige un hueco libre y confirma. Solo puedes tener una cita activa.</p>
    </header>

    {
      myBooking && (
        <section class="my-booking">
          <div class="my-booking__label">Tu próxima cita</div>
          <div class="my-booking__when">
            {capitalize(
              formatMadrid(myBooking.appointmentDate, {
                weekday: "long",
                day: "numeric",
                month: "long",
              }),
            )}
            {" · "}
            {formatMadrid(myBooking.appointmentDate, {
              hour: "2-digit",
              minute: "2-digit",
              hour12: false,
            })}
          </div>
          {myBooking.locationName && (
            <div class="my-booking__where">
              📍 {myBooking.locationName}
              {myBooking.locationAddress && ` — ${myBooking.locationAddress}`}
            </div>
          )}
        </section>
      )
    }

    <section class="card">
      {
        days.length === 0 ? (
          <div class="empty">
            <div class="empty__icon">💈</div>
            <p class="empty__title">No hay huecos publicados ahora mismo</p>
            <p class="empty__text">Vuelve a mirar en un rato.</p>
          </div>
        ) : (
          <>
            <div class="day-strip" role="tablist" aria-label="Días disponibles">
              {days.map((day) => (
                <button
                  class:list={[
                    "day-pill",
                    { "day-pill--active": day.key === initialDay, "day-pill--full": day.freeCount === 0 },
                  ]}
                  type="button"
                  role="tab"
                  data-day={day.key}
                  aria-selected={day.key === initialDay ? "true" : "false"}
                >
                  <span class="day-pill__weekday">{day.weekday.toUpperCase()}</span>
                  <span class="day-pill__number">{day.dayNumber}</span>
                  <span class="day-pill__month">{day.month.toUpperCase()}</span>
                  <span class="day-pill__free">
                    {day.freeCount === 0 ? "Completo" : `${day.freeCount} libre${day.freeCount === 1 ? "" : "s"}`}
                  </span>
                </button>
              ))}
            </div>

            {days.map((day) => (
              <div
                class="hours"
                data-day-panel={day.key}
                role="tabpanel"
                hidden={day.key !== initialDay}
              >
                <div class="hours__title">
                  {capitalize(
                    formatMadrid(day.slots[0].appointmentDate, {
                      weekday: "long",
                      day: "numeric",
                      month: "long",
                    }),
                  )}
                  {day.key === todayKey && <span class="badge badge--warning">Hoy</span>}
                </div>

                <ul class="hour-list">
                  {day.slots.map((slot) => (
                    <li>
                      <button
                        class:list={[
                          "hour",
                          {
                            "hour--taken": slot.isBooked && !slot.isMine,
                            "hour--mine": slot.isMine,
                          },
                        ]}
                        type="button"
                        data-slot-id={slot.id}
                        disabled={slot.isBooked}
                      >
                        <span class="hour__time">
                          {formatMadrid(slot.appointmentDate, {
                            hour: "2-digit",
                            minute: "2-digit",
                            hour12: false,
                          })}
                        </span>

                        {slot.locationName && (
                          <span
                            class="hour__place"
                            style={slot.locationColor ? `color:${slot.locationColor}` : undefined}
                          >
                            <span class="badge__dot" />
                            {slot.locationName}
                          </span>
                        )}

                        <span
                          class:list={[
                            "badge",
                            slot.isMine
                              ? "badge--info"
                              : slot.isBooked
                                ? "badge--danger"
                                : "badge--success",
                          ]}
                        >
                          {slot.isMine ? "Tu reserva" : slot.isBooked ? "Ocupada" : "Libre"}
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            <button id="confirm-button" class="btn btn--primary btn--block" type="button" disabled>
              Confirmar reserva
            </button>
            <p id="selection-hint" class="selection-hint">
              {myBooking
                ? "Ya tienes una cita reservada. Pide al barbero que la cancele si necesitas cambiarla."
                : "Selecciona una hora libre para continuar."}
            </p>
          </>
        )
      }
    </section>
  </main>
</Layout>

<script>
  import { toast } from "@/lib/toast";

  const confirmButton = document.getElementById("confirm-button") as HTMLButtonElement | null;
  const hint = document.getElementById("selection-hint");

  let selectedId: string | null = null;

  // --- Cambio de día -------------------------------------------------------
  document.querySelectorAll<HTMLButtonElement>("[data-day]").forEach((pill) => {
    pill.addEventListener("click", () => {
      const day = pill.dataset.day;

      document.querySelectorAll<HTMLElement>("[data-day]").forEach((other) => {
        const active = other === pill;
        other.classList.toggle("day-pill--active", active);
        other.setAttribute("aria-selected", String(active));
      });

      document.querySelectorAll<HTMLElement>("[data-day-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.dayPanel !== day;
      });

      clearSelection();
    });
  });

  // --- Selección de hora ---------------------------------------------------
  document.querySelectorAll<HTMLButtonElement>(".hour:not([disabled])").forEach((hour) => {
    hour.addEventListener("click", () => {
      document.querySelectorAll(".hour").forEach((other) => other.classList.remove("hour--selected"));
      hour.classList.add("hour--selected");
      selectedId = hour.dataset.slotId ?? null;

      if (confirmButton) confirmButton.disabled = !selectedId;
      if (hint) hint.textContent = "Pulsa «Confirmar reserva» para guardar tu cita.";
    });
  });

  function clearSelection() {
    selectedId = null;
    document.querySelectorAll(".hour").forEach((hour) => hour.classList.remove("hour--selected"));
    if (confirmButton) confirmButton.disabled = true;
  }

  // --- Confirmación --------------------------------------------------------
  confirmButton?.addEventListener("click", async () => {
    if (!selectedId) return;

    confirmButton.disabled = true;

    try {
      const response = await fetch(`/api/appointments/${selectedId}`, { method: "PATCH" });
      const result = await response.json();

      if (result.success) {
        toast.success(result.message);
        setTimeout(() => window.location.reload(), 900);
        return;
      }

      toast.error(result.error || "No se ha podido reservar la cita.");
      // El hueco puede haberlo cogido otra persona: se recarga para verlo.
      setTimeout(() => window.location.reload(), 1800);
    } catch {
      toast.error("No hay conexión con el servidor. Inténtalo de nuevo.");
      confirmButton.disabled = false;
    }
  });
</script>

<style>
  .page--booking {
    max-width: 560px;
  }

  .booking-head {
    margin-bottom: 20px;
  }

  .my-booking {
    background: var(--info-soft);
    border: 1px solid rgba(127, 178, 240, 0.3);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    margin-bottom: 20px;
  }

  .my-booking__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--info);
    margin-bottom: 4px;
  }

  .my-booking__when {
    font-size: 17px;
    font-weight: 600;
  }

  .my-booking__where {
    font-size: 13.5px;
    color: var(--text-muted);
    margin-top: 3px;
  }

  /* ---- Días ---- */

  .day-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: 22px;
    scrollbar-width: thin;
  }

  .day-strip::-webkit-scrollbar { height: 5px; }
  .day-strip::-webkit-scrollbar-track { background: transparent; }
  .day-strip::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 99px;
  }

  .day-pill {
    flex-shrink: 0;
    min-width: 82px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 11px 10px 9px;
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.12s ease;
  }

  .day-pill:hover {
    border-color: var(--border-strong);
  }

  .day-pill--active {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .day-pill--full {
    opacity: 0.5;
  }

  .day-pill__weekday {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }

  .day-pill--active .day-pill__weekday {
    color: var(--accent-strong);
  }

  .day-pill__number {
    font-size: 21px;
    font-weight: 650;
    line-height: 1.15;
  }

  .day-pill__month {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--text-subtle);
  }

  .day-pill__free {
    margin-top: 4px;
    font-size: 10.5px;
    color: var(--text-subtle);
  }

  /* ---- Horas ---- */

  .hours__title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .hour-list {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hour {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.14s ease;
  }

  .hour:hover:not(:disabled) {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    transform: translateX(3px);
  }

  .hour:disabled {
    cursor: not-allowed;
  }

  .hour--taken {
    opacity: 0.5;
  }

  .hour--taken .hour__time {
    text-decoration: line-through;
  }

  .hour--mine {
    opacity: 1;
    background: var(--info-soft);
    border-color: rgba(127, 178, 240, 0.32);
  }

  .hour--selected {
    background: var(--accent-soft);
    border-color: var(--accent);
    transform: translateX(3px);
  }

  .hour__time {
    font-size: 17px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .hour__place {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    color: var(--text-muted);
    flex: 1;
    min-width: 0;
  }

  .hour .badge {
    margin-left: auto;
  }

  .hour__place + .badge {
    margin-left: 0;
  }

  .selection-hint {
    text-align: center;
    color: var(--text-subtle);
    font-size: 13px;
    margin-top: 12px;
  }
</style>
