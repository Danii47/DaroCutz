---
import Layout from "@/layouts/Layout.astro";

const notice =
  Astro.url.searchParams.get("error") === "pending"
    ? "Tu cuenta todavía está pendiente de aprobación."
    : null;
---

<Layout title="Iniciar sesión" description="Accede a tu cuenta para gestionar tus reservas" bare>
  <main class="page page--narrow">
    <div class="card auth">
      <div class="auth__head">
        <span class="brand__mark auth__mark" aria-hidden="true">✂</span>
        <h1 class="auth__title">DaroCutz</h1>
        <p class="page-subtitle">Entra para reservar tu cita</p>
      </div>

      {notice && <p class="auth__notice">{notice}</p>}

      <form id="login-form" novalidate>
        <div class="field">
          <label class="field__label" for="email">Correo electrónico</label>
          <input
            class="input"
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            placeholder="tu@email.com"
            required
          />
        </div>

        <div class="field">
          <label class="field__label" for="password">Contraseña</label>
          <input
            class="input"
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            placeholder="••••••••"
            required
          />
        </div>

        <label class="checkbox auth__remember">
          <input type="checkbox" id="remember" name="remember" />
          <span>Mantener la sesión iniciada</span>
        </label>

        <button class="btn btn--primary btn--block" type="submit">Iniciar sesión</button>
      </form>

      <div class="divider"><span>o</span></div>

      <p class="auth__foot">¿No tienes cuenta? <a href="/register">Regístrate</a></p>
    </div>
  </main>
</Layout>

<script>
  import { toast } from "@/lib/toast";

  const form = document.getElementById("login-form") as HTMLFormElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    button.disabled = true;

    try {
      const response = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: String(data.get("email") || ""),
          password: String(data.get("password") || ""),
          remember: data.get("remember") === "on",
        }),
      });

      const result = await response.json();

      if (result.success) {
        toast.success(result.message);
        window.location.href = result.redirectTo || "/";
        return;
      }

      toast.error(result.error);
      button.disabled = false;
    } catch {
      toast.error("No hay conexión con el servidor. Inténtalo de nuevo.");
      button.disabled = false;
    }
  });
</script>

<style>
  .auth {
    padding: 34px 30px;
  }

  .auth__head {
    text-align: center;
    margin-bottom: 26px;
  }

  .auth__mark {
    width: 44px;
    height: 44px;
    margin: 0 auto 14px;
    font-size: 21px;
    border-radius: 13px;
  }

  .auth__title {
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .auth__notice {
    background: var(--warning-soft);
    border: 1px solid rgba(232, 191, 106, 0.32);
    color: var(--warning);
    border-radius: var(--radius-sm);
    padding: 11px 14px;
    font-size: 13.5px;
    margin-bottom: 20px;
  }

  .auth__remember {
    margin: 18px 0;
  }

  .auth__foot {
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .auth {
      padding: 28px 22px;
    }
  }
</style>
