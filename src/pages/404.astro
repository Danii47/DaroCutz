---
import Layout from "@/layouts/Layout.astro";

const user = Astro.locals.user;
const homeHref = user ? (user.isAdmin ? "/admin" : "/request-appointment") : "/login";
---

<Layout title="Página no encontrada" description="La página que buscas no existe" bare>
  <main class="page page--narrow">
    <div class="card notfound">
      <span class="notfound__code">404</span>
      <h1 class="notfound__title">Aquí no hay nada que cortar</h1>
      <p class="page-subtitle">La página que buscas no existe o ha cambiado de sitio.</p>
      <a class="btn btn--primary btn--block notfound__cta" href={homeHref}>Volver al inicio</a>
    </div>
  </main>
</Layout>

<style>
  .notfound {
    text-align: center;
    padding: 44px 30px;
  }

  .notfound__code {
    display: block;
    font-size: 62px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .notfound__title {
    font-size: 21px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .notfound__cta {
    margin-top: 26px;
  }
</style>
